generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(PENDING)
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  
  passwordResetTokens PasswordResetToken[]
  
  @@map("users")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("password_reset_tokens")
}

enum UserRole {
  ADMIN
  INSERTEUR
  CLIENT
  PENDING
}

model Compteur {
  id            Int            @id @default(autoincrement())
  quartier      String
  localisation  String
  loue          Boolean        @default(false)
  codeImmeuble  String         @default("N/A")
  nomPropriete  String         @default("N/A")
  typeBien      String         @default("placement")
  province      String         @default("N/A")
  adresse       String         @default("N/A")
  rg            String

  sousCompteurs SousCompteur[]
  payments      Payment[]
}

model SousCompteur {
  id             Int       @id @default(autoincrement())
  numeroCompteur String    @unique
  typeCompteur   String    @default("eau")
  numeroFacture  String?
  montant        Float?
  compteurId     Int
  compteur       Compteur  @relation(fields: [compteurId], references: [id])
}

model PaymentBatch {
  id        Int       @id @default(autoincrement())
  date      DateTime  @default(now())
  total     Float
  payments  Payment[]
  chequePdf String?
  recuPdf String?
  moisPaiement Int?   // Nouveau champ: mois du paiement (1-12)
  anneePaiement Int?  // Nouveau champ: année du paiement
}

model Payment {
  id             Int          @id @default(autoincrement())
  montant        Float
  numeroFacture  String?
  numeroCompteur String
  typeCompteur   String
  compteurId     Int
  compteur       Compteur     @relation(fields: [compteurId], references: [id])
  batchId        Int
  batch          PaymentBatch @relation(fields: [batchId], references: [id])
}