generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int      @id @default(autoincrement())
  name            String
  email           String   @unique
  password        String
  profilePicture  String?  // Nouveau champ pour la photo de profil
  role            UserRole @default(PENDING)
  isActive        Boolean  @default(false)
  createdAt       DateTime @default(now())
  
  passwordResetTokens PasswordResetToken[]
  
  @@map("users")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("password_reset_tokens")
}

enum UserRole {
  ADMIN
  INSERTEUR
  CLIENT
  PENDING
}

model Compteur {
  id            Int            @id @default(autoincrement())
  quartier      String
  localisation  String
  loue          Boolean        @default(false)
  codeImmeuble  String?        @default("N/A")
  codeLocal     String?        @default("N/A")
  nomPropriete  String         @default("N/A")
  typeBien      String         @default("placement")
  province      String         @default("N/A")
  adresse       String?        @default("N/A")
  rg            String

  sousCompteurs SousCompteur[]
  payments      Payment[]
}

model SousCompteur {
  id             Int       @id @default(autoincrement())
  numeroCompteur String    @unique
  typeCompteur   String    @default("eau")
  compteurId     Int
  compteur       Compteur  @relation(fields: [compteurId], references: [id])
  factures       Facture[] // Nouvelle relation
}

// Nouveau modèle pour gérer plusieurs factures
model Facture {
  id              Int          @id @default(autoincrement())
  numeroFacture   String
  montant         Float
  mois            Int         // Mois de la facture (1-12)
  annee           Int         // Année de la facture
  sousCompteurId  Int
  sousCompteur    SousCompteur @relation(fields: [sousCompteurId], references: [id])
  payee           Boolean     @default(false)
  batchId         Int?
  batch           PaymentBatch? @relation(fields: [batchId], references: [id])
  createdAt       DateTime    @default(now())
}

model PaymentBatch {
  id        Int       @id @default(autoincrement())
  date      DateTime  @default(now())
  total     Float
  payments  Payment[]
  factures  Facture[]  // Ajouter cette ligne pour la relation inverse
  chequePdf String?
  recuPdf String?
  moisPaiement Int?
  anneePaiement Int?
}

model Payment {
  id             Int          @id @default(autoincrement())
  montant        Float
  numeroFacture  String?
  numeroCompteur String
  typeCompteur   String
  compteurId     Int
  compteur       Compteur     @relation(fields: [compteurId], references: [id])
  batchId        Int
  batch          PaymentBatch @relation(fields: [batchId], references: [id])
}